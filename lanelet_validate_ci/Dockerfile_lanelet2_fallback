# Only needed if `pip install lanelet2` does NOT put the `lanelet2_validate`
# CLI binary on PATH (the pip package sometimes ships only the Python
# bindings). In that case, build this image once, push it to a registry
# (e.g. ghcr.io), and point the workflow's `container:` at it instead of
# `ubuntu:20.04`, so it doesn't need to rebuild on every PR.
FROM ubuntu:20.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3-pip libboost-dev libeigen3-dev libgeographic-dev libpugixml-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install conan catkin_pkg numpy
RUN git clone https://github.com/fzi-forschungszentrum-informatik/Lanelet2.git /opt/lanelet2 \
    && cd /opt/lanelet2 && conan create . --build=missing
ENV PATH="/opt/lanelet2/build/bin:${PATH}"

# Note: the exact binary path may vary depending on the build output --
# build this image once by hand and confirm `lanelet2_validate` is
# actually on PATH before relying on it in CI.
